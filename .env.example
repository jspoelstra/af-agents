# Copy this file to .env and fill in your values.
#
# The scripts use python-dotenv to load these variables.

# Your Azure AI Foundry Project endpoint, e.g.
# https://<project-name>.<region>.api.azureml.ms
AZURE_AI_PROJECT_ENDPOINT=

# The model deployment name configured in your Foundry Project
AZURE_AI_MODEL_DEPLOYMENT_NAME=

# Optional: agent to run (defaults to MCPAgentNoAsk)
# MCPAgentNoAsk: MCP tool calls don’t require approval
# MCPAgentAsk: MCP tool calls always require approval
AZURE_AI_AGENT_NAME=MCPAgentNoAsk
